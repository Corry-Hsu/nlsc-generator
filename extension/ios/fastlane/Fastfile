require 'base64'
require 'net/http'
require 'json'

default_platform(:ios)

platform :ios do
  desc 'Build and upload using encrypted signing files in a separate PRIVATE repository'
  lane :beta do
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 MATCH_PASSWORD MATCH_GIT_TOKEN MATCH_GIT_URL NLSC_BUNDLE_ID APPLE_TEAM_ID]
    missing = required.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing settings: #{missing.join(', ')}") unless missing.empty?
    UI.user_error!('Signing repository must differ from the public source repository') if ENV['MATCH_GIT_URL'].include?('/nlsc-generator.git')
    UI.user_error!('Invalid bundle identifier') unless ENV['NLSC_BUNDLE_ID'].match?(/\A[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+\z/)
    UI.user_error!('Invalid Apple Team ID') unless ENV['APPLE_TEAM_ID'].match?(/\A[A-Z0-9]{10}\z/)
    repo = ENV['MATCH_GIT_URL'].match(%r{\Ahttps://github\.com/([\w.-]+/[\w.-]+?)(?:\.git)?\z})
    UI.user_error!('MATCH_GIT_URL must be an HTTPS GitHub repository URL without credentials') unless repo
    uri = URI("https://api.github.com/repos/#{repo[1]}")
    request = Net::HTTP::Get.new(uri)
    request['Authorization'] = "Bearer #{ENV.fetch('MATCH_GIT_TOKEN')}"
    request['Accept'] = 'application/vnd.github+json'
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 15, read_timeout: 30) { |http| http.request(request) }
    UI.user_error!('Cannot access signing repository; check token and URL') unless response.code == '200'
    UI.user_error!('Signing repository must be PRIVATE') unless JSON.parse(response.body)['private'] == true
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8'), duration: 1200, in_house: false
    )
    # Only bootstrap is allowed to create signing assets; normal uploads are read-only.
    match(
      type: 'appstore', storage_mode: 'git', git_url: ENV.fetch('MATCH_GIT_URL'),
      git_branch: 'main',
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}"),
      api_key: api_key, app_identifier: ENV.fetch('NLSC_BUNDLE_ID'), team_id: ENV.fetch('APPLE_TEAM_ID'),
      readonly: ENV['SIGNING_MODE'] != 'bootstrap'
    )
    # Run attempt also changes on reruns, avoiding duplicate TestFlight build numbers.
    build_number = "#{ENV.fetch('GITHUB_RUN_NUMBER')}.#{ENV.fetch('GITHUB_RUN_ATTEMPT', '1')}"
    build_app(
      project: 'NLSCMobile.xcodeproj', scheme: 'NLSCMobile', clean: true,
      export_method: 'app-store', output_directory: 'build', output_name: 'NLSCMobile.ipa',
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} PRODUCT_BUNDLE_IDENTIFIER=#{ENV.fetch('NLSC_BUNDLE_ID')} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{ENV.fetch('NLSC_BUNDLE_ID')}'",
      export_options: {
        signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'),
        provisioningProfiles: { ENV.fetch('NLSC_BUNDLE_ID') => "match AppStore #{ENV.fetch('NLSC_BUNDLE_ID')}" }
      }
    )
    upload_to_testflight(api_key: api_key, app_identifier: ENV.fetch('NLSC_BUNDLE_ID'),
                         ipa: 'build/NLSCMobile.ipa', skip_waiting_for_build_processing: true)
  end
end
